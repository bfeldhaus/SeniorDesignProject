using System;
using System.Collections.Concurrent;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Logging;

namespace UCtrafficAPI.Controllers
{
    [ApiController]
    [Route("api/[controller]")]
    public class AuthController : ControllerBase
    {
        private readonly ILogger<AuthController> _logger;

        // Failed attempts store: key = username or IP, value = info
        private static ConcurrentDictionary<string, FailedLoginInfo> _failedLogins = new();

        // Configurable limits
        private const int MAX_FAILED_ATTEMPTS = 5;
        private static readonly TimeSpan LOCKOUT_DURATION = TimeSpan.FromMinutes(10);
        private static readonly TimeSpan ATTEMPT_RESET_AFTER = TimeSpan.FromMinutes(30);

        public AuthController(ILogger<AuthController> logger)
        {
            _logger = logger;
        }

        [HttpPost("login")]
        public async Task<IActionResult> Login([FromBody] LoginRequest request)
        {
            string key = request.Username.ToLower(); 
            // You might also combine IP or user to make the key more robust
            string ip = HttpContext.Connection.RemoteIpAddress?.ToString();
            string ipKey = "IP_" + ip;

            // Clean up or reset old entries
            CleanupOldEntries(key);
            CleanupOldEntries(ipKey);

            // Check lockout status
            if (IsLockedOut(key, out var waitTimeUser))
            {
                return StatusCode(429, $"Too many failed login attempts. Try again in {waitTimeUser.Minutes} min.");
            }

            if (IsLockedOut(ipKey, out var waitTimeIp))
            {
                return StatusCode(429, $"Too many attempts from this IP. Try again in {waitTimeIp.Minutes} min.");
            }

            // Authenticate (dummy example)
            bool success = await AuthenticateUserAsync(request.Username, request.Password);

            if (!success)
            {
                RegisterFailedAttempt(key);
                RegisterFailedAttempt(ipKey);

                return Unauthorized("Invalid username or password.");
            }

            // Reset failed counters on success
            _failedLogins.TryRemove(key, out _);
            _failedLogins.TryRemove(ipKey, out _);

            // Continue with issuing token, etc.
            // ...

            return Ok("Login successful");
        }

        private async Task<bool> AuthenticateUserAsync(string username, string password)
        {
            // Replace this with real logic (check hashed password in DB)
            await Task.Delay(50); 
            return (username == "testuser" && password == "Password123!");
        }

        private void RegisterFailedAttempt(string key)
        {
            var info = _failedLogins.GetOrAdd(key, new FailedLoginInfo());
            lock (info) 
            {
                info.AttemptCount++;
                info.LastFailedTime = DateTime.UtcNow;
                if (info.AttemptCount >= MAX_FAILED_ATTEMPTS)
                {
                    info.LockedUntil = DateTime.UtcNow + LOCKOUT_DURATION;
                }
            }
        }

        private bool IsLockedOut(string key, out TimeSpan waitTime)
        {
            waitTime = TimeSpan.Zero;
            if (_failedLogins.TryGetValue(key, out var info))
            {
                if (info.LockedUntil.HasValue && info.LockedUntil > DateTime.UtcNow)
                {
                    waitTime = info.LockedUntil.Value - DateTime.UtcNow;
                    return true;
                }
            }
            return false;
        }

        private void CleanupOldEntries(string key)
        {
            if (_failedLogins.TryGetValue(key, out var info))
            {
                // If last failed attempt was long ago, reset
                if (info.LastFailedTime + ATTEMPT_RESET_AFTER < DateTime.UtcNow && info.LockedUntil < DateTime.UtcNow)
                {
                    _failedLogins.TryRemove(key, out _);
                }
            }
        }

        class FailedLoginInfo
        {
            public int AttemptCount { get; set; } = 0;
            public DateTime LastFailedTime { get; set; } = DateTime.UtcNow;
            public DateTime? LockedUntil { get; set; } = null;
        }

        public class LoginRequest
        {
            public string Username { get; set; }
            public string Password { get; set; }
        }
    }
}
